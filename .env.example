# Para rodar com dados reais do seu issue tracker (ex: Jira, Linear, GitHub Issues)
TRACKER_EMAIL=seu@email.com
TRACKER_API_TOKEN=seu_token_de_api
TRACKER_BASE_URL=https://sua-empresa.atlassian.net
TRACKER_ACCOUNT_ID=seu_account_id
TRACKER_PROJECT_KEY=PROJ

# Para rodar em modo demonstração (sem issue tracker, usa tracker-cards.example.json)
DEMO_MODE=false
VITE_DEMO_MODE=false

VITE_TRACKER_BASE_URL=https://sua-empresa.atlassian.net

CHROMA_URL=http://localhost:8000
MODEL_PATH=./data/model
